# Copy this file to .env.local and fill in values from the dashboards.
# Never commit .env.local.

# Supabase — Project Settings → Data API / API Keys
# Use the project URL (https://xxxx.supabase.co), not the /rest/v1 Data API path.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chat (OpenAI-compatible). DeepSeek is chat-only and has no embeddings API.
# Local Ollama: http://127.0.0.1:11434/v1  model qwen2.5:14b  key ollama
# Production:   https://api.deepseek.com/v1  model deepseek-flash
# DeepSeek defaults thinking on; this app disables it automatically for api.deepseek.com
# so JSON grading and question generation return content, not an empty chain-of-thought.
# Override with AI_CHAT_THINKING=enabled or disabled if you need to.
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
# AI_CHAT_THINKING=

# Embeddings (OpenAI-compatible). Must stay 1024 dimensions to match chunks.embedding.
# Local Ollama bge-m3 (no 身份证, works offline):
#   ollama pull bge-m3
#   AI_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
#   AI_EMBEDDING_API_KEY=ollama
#   AI_EMBEDDING_MODEL=bge-m3
#   AI_EMBEDDING_DIMENSIONS=1024
# Production — Jina embeddings v3 (email/GitHub signup, no Chinese ID, 1024 dims):
#   AI_EMBEDDING_BASE_URL=https://api.jina.ai/v1
#   AI_EMBEDDING_MODEL=jina-embeddings-v3
#   AI_EMBEDDING_DIMENSIONS=1024
# Same-model alternative if this Supabase already has Ollama bge-m3 vectors:
#   Novita baai/bge-m3 at https://api.novita.ai/v3/openai
# Do not mix embedding models in one database. Re-upload PDFs after switching.
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=

# Canonical public origin. Optional in local dev (defaults to http://localhost:4317).
# Required on the host so Open Graph links and metadata match the live URL.
# NEXT_PUBLIC_SITE_URL=http://localhost:4317
# NEXT_PUBLIC_SITE_URL=https://your-service.zeabur.app
NEXT_PUBLIC_SITE_URL=
