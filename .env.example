# Copy this file to .env.local and fill in values from the Supabase dashboard.
# Project Settings → Data API (or API): Project URL and anon / public key.
# Project Settings → API Keys: service_role secret. Never expose that key to the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
