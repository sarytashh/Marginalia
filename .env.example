# Copy this file to .env.local and fill in values from the dashboards.
# Never commit .env.local.

# Supabase — Project Settings → Data API / API Keys
# Use the project URL (https://xxxx.supabase.co), not the /rest/v1 Data API path.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chat (OpenAI-compatible).
# Local Ollama: http://127.0.0.1:11434/v1  model qwen2.5:14b  key ollama
# Hosted Gemini (key from https://aistudio.google.com, not reachable from mainland China/HK):
#   https://generativelanguage.googleapis.com/v1beta/openai/  model gemini-3.5-flash-lite
# Pick a Flash-Lite model on the free tier: far more requests per day than Flash.
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
# AI_CHAT_THINKING=

# Embeddings (OpenAI-compatible). Must stay 1024 dimensions to match chunks.embedding.
# Local Ollama bge-m3 (works offline):
#   ollama pull bge-m3
#   AI_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
#   AI_EMBEDDING_API_KEY=ollama
#   AI_EMBEDDING_MODEL=bge-m3
#   AI_EMBEDDING_DIMENSIONS=1024
# Hosted Gemini (same key as chat; hosted providers are asked for 1024 dimensions):
#   AI_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   AI_EMBEDDING_MODEL=the Gemini embedding model ID shown in AI Studio
#   AI_EMBEDDING_DIMENSIONS=1024
# Do not mix embedding models in one database. Re-upload PDFs after switching.
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=

# Canonical public origin. Optional in local dev (defaults to http://localhost:4317).
# Required on the host so Open Graph links and metadata match the live URL.
# NEXT_PUBLIC_SITE_URL=http://localhost:4317
# NEXT_PUBLIC_SITE_URL=https://your-service.zeabur.app
NEXT_PUBLIC_SITE_URL=
