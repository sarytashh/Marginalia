# Copy this file to .env.local and fill in values from the dashboards.
# Never commit .env.local.

# Supabase — Project Settings → Data API / API Keys
# Use the project URL (https://xxxx.supabase.co), not the /rest/v1 Data API path.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chat (OpenAI-compatible). DeepSeek is chat-only and has no embeddings API.
# AI_CHAT_BASE_URL=https://api.deepseek.com/v1
# AI_CHAT_MODEL=deepseek-chat
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=

# Embeddings (OpenAI-compatible). Local Ollama bge-m3: no 身份证, works offline.
# ollama pull bge-m3
# AI_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# AI_EMBEDDING_API_KEY=ollama
# AI_EMBEDDING_MODEL=bge-m3
# AI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=

# Optional. Magic-link emails use the current origin by default (http://localhost:4317 in dev).
# Set this if you need a stable redirect origin in production.
# NEXT_PUBLIC_SITE_URL=http://localhost:4317
